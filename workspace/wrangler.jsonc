{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workspace",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // No id on purpose: wrangler creates the namespace on first deploy, so the
  // template carries no account-specific values.
  "kv_namespaces": [{ "binding": "CACHE" }],

  // Refresh the snapshot every 15 minutes. Page views only read KV.
  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    // Comma-separated GitHub users or organizations to track.
    "GITHUB_OWNERS": "lamlabs,lamtran2601",
    // Cloudflare Access: team domain (e.g. "myteam.cloudflareaccess.com") and
    // the application's AUD tag. While either is empty every request is refused.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
  // Secrets (set with `wrangler secret put`, never in this file):
  //   GITHUB_TOKEN, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
}
